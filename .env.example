# Core app
PORT=5000
FLASK_RUN_HOST=0.0.0.0
FLASK_DEBUG=true
APP_BASE_URL=http://127.0.0.1:5000
SESSION_COOKIE_SECURE=false

# Secret management
# If omitted, HashVera generates local secret files automatically.
SECRET_KEY=
NODE_SIGNING_SECRET=
NODE_SIGNING_KEY_ID=campus-node-1-key

# Local node identity
NODE_NAME=Campus-Node-1
NODE_LOCATION=Main Campus

# Peer API auth
HASHVERA_PEER_SHARED_TOKEN=replace-with-a-shared-network-token
PEER_REQUEST_TIMEOUT=5

# Optional one-time admin bootstrap
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@hashvera.edu.in
ADMIN_PASSWORD=

# SMTP password reset
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_USE_TLS=true
MAIL_FROM=your-email@gmail.com

# SMS password recovery
# Use E.164 phone numbers, for example +919876543210.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+10000000000

# Optional AI assistant
# Without API keys, HashVera Assist uses the built-in local help mode.
GEMINI_API_KEY=AQ.Ab8RN6JURTdkVUXTrfqRbpMOmj9One3ZjukyKejzedPeGNN0kQ
OPENAI_API_KEY=
HASHVERA_AI_MODEL=gemini-1.5-flash
HASHVERA_AI_TIMEOUT=12

# Optional peer preload
# JSON format:
# HASHVERA_PEERS=[{"name":"Campus-Node-2","location":"Regional Office","url":"http://127.0.0.1:5001","api_token":"replace-with-token","signing_key_id":"campus-node-2-key","signing_secret":"replace-with-peer-secret"}]
HASHVERA_PEERS=
