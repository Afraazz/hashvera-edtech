.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(21, 36, 58, 0.18);
    backdrop-filter: blur(3px);
    display: grid;
    place-items: center;
    z-index: 50;
}

.modal-card {
    width: min(460px, calc(100% - 24px));
    background: rgba(255, 251, 245, 0.98);
    border: 1px solid var(--line);
    border-radius: 24px;
    box-shadow: var(--shadow);
    padding: 24px;
}

.modal-card h2 {
    color: #1d2940;
}

.modal-card .muted {
    color: #667892;
}

body[data-theme="dark"] .modal-card h2 {
    color: #1d2940;
}

body[data-theme="dark"] .modal-card .muted {
    color: #667892;
}

.modal-actions {
    justify-content: flex-end;
    margin-top: 18px;
}

#modal-cancel {
    background: linear-gradient(135deg, #b83d4d 0%, #cf4c5f 55%, #e06475 100%);
    color: #ffffff;
    box-shadow: 0 12px 24px rgba(184, 64, 76, 0.22);
}

#modal-cancel:hover {
    background: linear-gradient(135deg, #aa3243 0%, #c44256 55%, #d85b6e 100%);
}

body[data-theme="dark"] #modal-cancel {
    background: linear-gradient(135deg, #c53d4f 0%, #db4f64 52%, #ef7283 100%);
