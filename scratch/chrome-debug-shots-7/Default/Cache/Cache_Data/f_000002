@font-face {
    font-family: "Arista Pro";
    src: url("/static/fonts/arista-pro.pro-trial-bold.ttf") format("truetype");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: "Arista Pro";
    src: url("/static/fonts/arista-pro.pro-trial-semibold.ttf") format("truetype");
    font-weight: 600;
    font-style: normal;
    font-display: swap;
}

@font-face {
    font-family: "Arista Pro Icons";
    src: url("/static/fonts/arista-pro.pro-icons-extralight.ttf") format("truetype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
}

:root {
    --bg: #f8fafc;
    --ink: #0f172a;
    --muted: #64748b;
    --panel: rgba(255, 255, 255, 0.85);
    --panel-strong: #ffffff;
    --line: rgba(15, 23, 42, 0.08);
    --primary: #0f766e;
    --primary-glow: rgba(15, 118, 110, 0.2);
    --secondary: #0369a1;
    --danger: #ef4444;
    --success: #10b981;
    --shadow: 0 16px 32px -8px rgba(15, 23, 42, 0.08), 0 0 16px rgba(15, 118, 110, 0.04);
    --shadow-soft: 0 8px 16px -4px rgba(15, 23, 42, 0.06);
    --ring: 0 0 0 4px rgba(15, 118, 110, 0.12);
    --glass-blur: none;
    --text-main: #0f172a;
    --text-muted: #64748b;
    --panel-bg: #ffffff;
}

* {
    box-sizing: border-box;
}

a, button, input, select, textarea, .card, .panel, .dashboard-item, .ghost-button, .icon-button {
    transition: background-color 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
                border-color 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
                color 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
                transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
                box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
                opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
}

[hidden] {
    display: none !important;
}

.sr-only {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0 0 0 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
}

html {
    scroll-behavior: smooth;
    margin: 0 !important;
    padding: 0 !important;
}

body {
    margin: 0 !important;
    padding: 0 !important;
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink);
    background:
        radial-gradient(circle at 10% 10%, rgba(15, 118, 110, 0.05) 0%, transparent 40%),
        radial-gradient(circle at 90% 90%, rgba(3, 105, 161, 0.05) 0%, transparent 40%),
        linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
    background-attachment: scroll;
    min-height: 100vh;
    overflow-x: hidden;
    transition: background 0.5s cubic-bezier(0.4, 0, 0.2, 1), color 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

body[data-theme="dark"] {
    --ink: #f8fafc;
    --muted: #94a3b8;
    --panel: rgba(15, 23, 42, 0.75);
    --panel-strong: #1e293b;
    --line: rgba(255, 255, 255, 0.08);
    --primary: #2dd4bf;
    --primary-glow: rgba(45, 212, 191, 0.15);
    --secondary: #38bdf8;
    --danger: #f87171;
    --success: #34d399;
    --shadow: 0 16px 32px -8px rgba(0, 0, 0, 0.4), 0 0 16px rgba(45, 212, 191, 0.05);
    --shadow-soft: 0 10px 28px rgba(0, 0, 0, 0.3);
    --ring: 0 0 0 4px rgba(45, 212, 191, 0.15);
    --text-main: #f8fafc;
    --text-muted: #94a3b8;
    --panel-bg: #1e293b;
    background:
        radial-gradient(circle at 15% 15%, rgba(45, 212, 191, 0.08) 0%, transparent 35%),
        radial-gradient(circle at 85% 85%, rgba(56, 189, 248, 0.08) 0%, transparent 35%),
        linear-gradient(135deg, #0b0f19 0%, #1e293b 100%);
}

body[data-theme="dark"] input,
body[data-theme="dark"] select,
body[data-theme="dark"] textarea {
    background: rgba(15, 29, 46, 0.92);
    border-color: rgba(186, 202, 226, 0.14);
    color: var(--ink);
}

body[data-theme="dark"] .helper-link a,
body[data-theme="dark"] .switch-link a,
body[data-theme="dark"] .block-card a {
    color: var(--primary);
}

.page-shell {
    width: min(calc(100% - 30px), 1760px);
    margin: 0 auto;
    padding: 16px 0 32px;
    animation: shellFade 0.55s ease;
    position: relative;
}

.brand-banner {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: var(--ink);
    margin-bottom: 20px;
    padding: 8px 0;
}

.brand-icon {
    width: 46px;
    height: 46px;
    display: block;
    flex-shrink: 0;
    transform: translateY(-4px);
}

.brand-text-lockup {
    display: inline-flex;
    align-items: center;
    line-height: 1;
    letter-spacing: -0.012em;
}

.dashboard-page .brand-banner {
    align-items: flex-start;
}

.dashboard-page .brand-icon {
    transform: translateY(-8px);
}

.dashboard-page .brand-text-lockup {
    transform: translateY(-3px);
}

.premium-heading {
    font-family: "Outfit", sans-serif !important;
    background: linear-gradient(135deg, var(--ink) 0%, #1e293b 100%) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
    background-clip: text !important;
    display: inline-block !important;
    letter-spacing: -0.03em !important;
    font-weight: 700 !important;
    text-transform: none !important;
    font-size: clamp(1.8rem, 5vw, 3.5rem) !important;
}

body[data-theme="dark"] .premium-heading {
    background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 100%) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
}

.brand-text {
    font-family: "Arista Pro", "Trebuchet MS", "Segoe UI", sans-serif;
    font-size: clamp(1.8rem, 2.6vw, 2.5rem);
    letter-spacing: -0.015em;
    font-weight: 600;
}

.brand-text-primary {
    color: #3c5f8d;
    font-weight: 700;
    margin-right: 0.045em;
}

.brand-text-secondary {
    color: #c26a3d;
    font-weight: 600;
    margin-left: 0;
}

body[data-theme="dark"] .brand-text-primary {
    color: #7fc4ff;
    opacity: 0.92;
}

body[data-theme="dark"] .brand-text-secondary {
    color: #ffb178;
}

body:not([data-theme="dark"]) .brand-text-primary {
    opacity: 0.82;
}

.brand-logo {
    width: clamp(180px, 24vw, 250px);
    height: auto;
    display: block;
}

.header-logo-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
    padding: 10px 0 18px;
    margin: 0;
}

.header-nav-actions {
    flex: 1 1 auto;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 20px;
    margin: 0 20px;
}

.header-logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    line-height: 1;
    padding: 4px 8px 4px 0;
}

.header-logo-container {
    flex: 0 0 auto;
}

.header-nav-actions {
    flex: 1 1 auto;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 15px;
    margin-left: 15px;
}

.header-verify-link {
    flex: 0 0 auto;
}

.header-logo-mark {
    width: 44px;
    height: 44px;
    display: block;
    flex: 0 0 auto;
    object-fit: contain;
    filter: drop-shadow(0 7px 14px rgba(15, 23, 42, 0.12));
}

.header-logo-wordmark {
    display: inline-flex;
    gap: 3px;
    align-items: baseline;
    font-family: "Arista Pro", "Trebuchet MS", "Segoe UI", sans-serif;
    font-size: 2.08rem;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-rendering: geometricPrecision;
    -webkit-font-smoothing: antialiased;
    filter: drop-shadow(0 1px 0 rgba(255, 255, 255, 0.38));
}

.header-logo-wordmark .brand-text-primary {
    color: #4c668d;
    opacity: 1;
}

.header-logo-wordmark .brand-text-secondary {
    color: #bf6330;
    font-weight: 700;
}

body[data-theme="dark"] .header-logo-mark {
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.32));
}

body[data-theme="dark"] .header-logo-wordmark .brand-text-primary {
    color: #9fc3f1;
}

body[data-theme="dark"] .header-logo-wordmark .brand-text-secondary {
    color: #ffb178;
}

.header-verify-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 46px;
    padding: 0 18px;
    border-radius: 14px;
    border: 1px solid rgba(15, 118, 110, 0.16);
    background: rgba(15, 118, 110, 0.08);
    color: var(--primary);
    text-decoration: none;
    font-weight: 800;
    box-shadow: var(--shadow-soft);
}

.header-verify-link:hover {
    transform: translateY(-1px);
    background: rgba(15, 118, 110, 0.12);
}

.header-verify-link ion-icon {
    font-size: 1.08rem;
}

body[data-theme="dark"] .header-verify-link {
    background: rgba(45, 212, 191, 0.12);
    border-color: rgba(45, 212, 191, 0.16);
}

.auth-layout {
    min-height: auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    align-items: start;
}

@media (max-width: 900px) {
    .auth-layout {
        grid-template-columns: 1fr;
    }
}

.wide-layout {
    grid-template-columns: 0.95fr 1.05fr;
}

.brand-panel,
.auth-card,
.panel,
.metric-card,
.block-card,
.node-card,
.chart-card,
.audit-card,
.user-admin-card {
    background: var(--panel);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    border-radius: 24px;
    transition:
        transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
        box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1),
        border-color 0.3s ease,
        background-color 0.3s ease;
}

.brand-panel,
.auth-card,
.panel {
    padding: 22px;
}

@media (min-width: 961px) {
    .auth-layout .brand-panel {
        align-self: center;
        margin-top: 0;
    }
}

.eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.78rem;
    color: var(--secondary);
    font-weight: 700;
}

h1,
h2,
h3,
p {
    margin-top: 0;
}

h1 {
    font-size: clamp(1.8rem, 2vw, 2.6rem);
    line-height: 1.15;
}

h2 {
    font-size: 1.25rem;
}

h3 {
    font-size: 1.02rem;
}

.lead,
.muted,
.panel-heading p,
.switch-link,
.helper-link {
    color: var(--muted);
}

.feature-list,
.tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 14px;
}

.feature-list span,
.user-chip,
.tag {
    padding: 5px 14px;
    border-radius: 999px;
    background: rgba(13, 110, 110, 0.1);
    color: var(--primary);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    transition: transform 0.22s ease, background-color 0.22s ease, color 0.22s ease;
}

.tag-danger {
    background: rgba(184, 64, 76, 0.14);
    color: var(--danger);
}

.status-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    padding: 8px 12px;
    border-radius: 999px;
    font-weight: 700;
    letter-spacing: 0.01em;
}

.status-badge-good {
    background: rgba(43, 140, 94, 0.14);
    color: var(--success);
}

.status-badge-danger {
    background: rgba(184, 64, 76, 0.14);
    color: var(--danger);
}

.auth-form,
.record-form,
.filter-form,
.admin-reset-form {
    display: grid;
    gap: 12px;
}

.admin-filter-form {
    margin-bottom: 18px;
    grid-template-columns: minmax(220px, 1.5fr) minmax(160px, 0.7fr) auto;
    align-items: end;
}

.admin-user-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 18px;
}

.pagination-bar {
    margin-top: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    padding: 24px 0;
    border-top: 1px dashed var(--line);
}

.pagination-summary {
    color: var(--muted);
    font-weight: 600;
}

.empty-state-card {
    padding: 20px 22px;
    border-radius: 22px;
    border: 1px dashed var(--line);
    background: rgba(255, 255, 255, 0.32);
    box-shadow: var(--shadow-soft);
    margin-bottom: 18px;
}

.empty-state-card h3 {
    margin-bottom: 6px;
}

.empty-state-card p {
    margin: 0;
    color: var(--muted);
}

.system-history-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
}

.system-history-card {
    padding: 18px 20px;
    border-radius: 22px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.32);
    box-shadow: var(--shadow-soft);
}

body[data-theme="dark"] .system-history-card {
    background: rgba(15, 29, 46, 0.72);
}

.filter-toggle {
    margin-bottom: 20px !important;
    border-radius: 12px !important;
    padding: 10px 24px !important;
    background: var(--primary) !important;
    color: white !important;
    font-weight: 700 !important;
    border: none !important;
    box-shadow: 0 4px 12px var(--primary-glow) !important;
}

.filter-toggle:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 8px 20px var(--primary-glow) !important;
    filter: brightness(1.1) !important;
}

body[data-theme="dark"] .filter-toggle {
    background: linear-gradient(135deg, #2dd4bf 0%, #0f766e 100%) !important;
    box-shadow: 0 4px 15px rgba(45, 212, 191, 0.25) !important;
}

.system-history-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
}

.system-history-time {
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 600;
    text-align: right;
}

.system-history-user,
.system-history-target,
.system-history-details {
    margin: 0 0 8px;
}

.system-history-details {
    color: var(--muted);
    margin-bottom: 0;
}

.action-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    padding: 0 8px;
    border-radius: 999px;
    background: rgba(13, 110, 110, 0.16);
    color: var(--primary);
    font-size: 0.8rem;
    font-weight: 800;
}

body[data-theme="dark"] .action-badge {
    background: rgba(103, 209, 202, 0.16);
}

.metrics-row, .metrics-ribbon {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 32px;
}

.charts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
}

@media (max-width: 1400px) {
    .charts-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 900px) {
    .charts-grid, .metrics-row {
        grid-template-columns: 1fr;
    }
}

.chart-card {
    padding: 32px;
    min-height: 380px;
    border-radius: 24px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.28);
    box-shadow: var(--shadow-soft);
}

.staff-summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
}

.summary-card {
    padding: 20px;
    border-radius: 24px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.28);
    box-shadow: var(--shadow-soft);
}

body[data-theme="dark"] .summary-card {
    background: rgba(15, 29, 46, 0.72);
}

.summary-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
}

.summary-list {
    display: grid;
    gap: 10px;
}

.summary-list-item {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    border-radius: 18px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.34);
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

body[data-theme="dark"] .summary-list-item {
    background: rgba(19, 35, 56, 0.82);
}

.summary-list-item:hover {
    transform: translateY(-2px);
    border-color: rgba(13, 110, 110, 0.24);
    box-shadow: var(--shadow-soft);
}

.summary-list-item span {
    color: var(--muted);
    font-size: 0.92rem;
}

.compact-empty {
    margin-bottom: 0;
    padding: 16px 18px;
}

.inline-form {
    margin: 0;
}

.inline-form button {
    margin: 0;
}

.checkbox-row {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-weight: 600;
}

.checkbox-row input {
    width: auto;
    margin: 0;
}

.inline-form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
}

.password-field {
    position: relative;
}

.password-field input {
    padding-right: 44px;
}

.toggle-password {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 28px;
    min-width: 28px;
    height: 28px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0;
    background: transparent;
    color: #7d8795;
    font-size: 1rem;
    font-weight: 400;
    box-shadow: none;
    border: none;
    outline: none;
    background: transparent !important;
    background-image: none !important;
    box-shadow: none !important;
    border: none !important;
}

.toggle-password svg {
    width: 20px;
    height: 20px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.toggle-password:hover {
    background: transparent !important;
    background-image: none !important;
    color: #7d8795;
    transform: translateY(-50%);
    box-shadow: none !important;
}

.toggle-password:active {
    transform: translateY(-50%);
    box-shadow: none !important;
    background: transparent !important;
}

.toggle-password:focus,
.toggle-password:focus-visible {
    outline: none;
    box-shadow: none !important;
    background: transparent !important;
}

body[data-theme="dark"] .toggle-password,
body[data-theme="dark"] .toggle-password:hover {
    background: transparent;
    color: #a7b6ca;
}

.password-field .toggle-password {
    position: absolute !important;
    top: 50% !important;
    right: 12px !important;
    left: auto !important;
    bottom: auto !important;
    transform: translateY(-50%) !important;
    margin: 0 !important;
    width: 28px;
    min-width: 28px;
    max-width: 28px;
    padding: 0 !important;
    flex: 0 0 28px;
}

.helper-link {
    margin: 12px 0 0;
    text-align: right;
}

.helper-link a,
.switch-link a,
.block-card a {
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
}

.helper-link a:hover,
.switch-link a:hover,
.block-card a:hover {
    text-decoration: underline;
}

.campus-id-link {
    font-weight: 700;
}

.campus-id-text {
    color: inherit;
    font-weight: 700;
}

label,
.field-caption {
    font-size: 0.92rem;
    font-weight: 600;
}

input,
select,
textarea,
button,
a {
    font: inherit;
}

input,
select,
textarea {
    width: 100%;
    min-height: 48px;
    padding: 13px 14px;
    border-radius: 14px;
    border: 1px solid rgba(21, 36, 58, 0.16);
    background: rgba(255, 255, 255, 0.96);
    color: var(--ink);
    transition:
        border-color 0.22s ease,
        box-shadow 0.22s ease,
        background-color 0.22s ease,
        transform 0.22s ease;
}

textarea {
    min-height: 120px;
    resize: vertical;
}

input:focus,
select:focus,
textarea:focus {
    outline: none;
    border-color: rgba(13, 110, 110, 0.4);
    box-shadow: var(--ring);
    background: #ffffff;
}

button,
.ghost-button,
.danger-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    padding: 12px 18px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    min-height: 44px;
    touch-action: manipulation;
    transition:
        transform 0.22s ease,
        opacity 0.22s ease,
        box-shadow 0.22s ease,
        background-color 0.22s ease,
        color 0.22s ease;
}

button {
    background: linear-gradient(135deg, var(--primary) 0%, #14b8a6 100%);
    color: white;
    font-weight: 700;
    box-shadow: 0 10px 20px var(--primary-glow);
}

.ghost-button {
    background: rgba(15, 118, 110, 0.1);
    color: var(--primary);
    font-weight: 700;
}

body[data-theme="dark"] .ghost-button,
body[data-theme="dark"] .user-chip,
body[data-theme="dark"] .tag,
body[data-theme="dark"] .feature-list span {
    background: rgba(45, 212, 191, 0.15);
}

.danger-button {
    background: linear-gradient(135deg, var(--danger) 0%, #f87171 100%);
    color: white;
    font-weight: 700;
    box-shadow: 0 10px 20px rgba(239, 68, 68, 0.2);
}

button:hover {
    background: linear-gradient(135deg, #1a8d8a 0%, #2ebbb4 52%, #68d2c8 100%);
}

body[data-theme="dark"] button {
    background: linear-gradient(135deg, #157d79 0%, #269f98 50%, #49bfb5 100%);
    box-shadow: 0 12px 24px rgba(38, 159, 152, 0.24);
}

body[data-theme="dark"] .danger-button {
    background: linear-gradient(135deg, #c53d4f 0%, #db4f64 52%, #ef7283 100%);
    box-shadow: 0 12px 24px rgba(219, 79, 100, 0.28);
}

body[data-theme="dark"] button:hover {
    background: linear-gradient(135deg, #126c69 0%, #208f89 50%, #3bb2aa 100%);
}

.danger-button:hover {
    background: linear-gradient(135deg, #aa3243 0%, #c44256 55%, #d85b6e 100%);
}

body[data-theme="dark"] .danger-button:hover {
    background: linear-gradient(135deg, #b63648 0%, #cf4860 52%, #e86b7d 100%);
}

button:hover,
.ghost-button:hover,
.danger-button:hover {
    transform: translateY(-2px);
    opacity: 0.98;
}

button:active,
.ghost-button:active,
.danger-button:active {
    transform: translateY(0);
}

.panel:hover,
.metric-card:hover,
.chart-card:hover,
.audit-card:hover,
.user-admin-card:hover,
.node-card:hover,
.block-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
    border-color: rgba(13, 110, 110, 0.18);
}

.topbar {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: center;
    margin-bottom: 28px;
}

.dashboard-page .topbar {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 30px;
    min-height: 86px;
}

.hero-copy {
    max-width: 760px;
}

.dashboard-toolbar {
    position: sticky;
    top: 18px;
    display: flex;
    gap: 14px;
    align-items: stretch;
    flex-wrap: nowrap;
    margin: 0;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.44);
    box-shadow: var(--shadow-soft);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    overflow: hidden;
    transition: padding 0.22s ease, border-radius 0.22s ease, background-color 0.22s ease;
}

.dashboard-shell {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 24px;
    align-items: start;
    transition: grid-template-columns 0.4s cubic-bezier(0.4, 0, 0.2, 1), gap 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: grid-template-columns;
}

.dashboard-main-content {
    min-width: 0;
    opacity: 1;
    transform: none;
}

@keyframes dashboardReveal {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
}

.dashboard-sidebar-hidden {
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 18px;
}

.dashboard-sidebar-hidden .dashboard-toolbar {
    display: flex !important;
    padding: 10px;
    border-radius: 18px;
}

.dashboard-sidebar-hidden .dashboard-action-groups {
    display: none !important;
}

.dashboard-sidebar-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    min-width: 44px;
    height: 44px;
    min-height: 44px;
    border-radius: 14px;
    padding: 0;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.5);
    color: var(--primary);
    box-shadow: none;
    white-space: nowrap;
}

.dashboard-sidebar-toggle ion-icon {
    font-size: 1.25rem;
}

.dashboard-sidebar-toggle:hover {
    background: rgba(15, 118, 110, 0.1);
    transform: translateY(-1px);
}

.dashboard-sidebar-toggle-close {
    margin: 0 auto 4px;
}

.dashboard-sidebar-hidden .dashboard-sidebar-toggle-close {
    width: 44px;
    min-width: 44px;
    height: 44px;
    padding: 0;
    margin: 0 auto;
}

.dashboard-sidebar-hidden .dashboard-sidebar-toggle-close span {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
}

.dashboard-identity-row {
    display: inline-flex;
    justify-content: flex-start;
    width: auto;
    max-width: 100%;
}

.dashboard-identity-row .user-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    min-width: 0;
}

.dashboard-header-search {
    position: relative;
    width: auto;
    min-width: 260px;
    z-index: 2;
}

.dashboard-page .topbar .hero-copy {
    flex: 1 1 auto;
    min-width: 0;
}

.dashboard-page .topbar-right-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
    flex: 0 0 auto;
    width: auto;
    align-self: center;
}

.dashboard-page .topbar-right-actions .dashboard-header-search {
    flex: 0 1 360px;
    min-width: 280px;
}

.dashboard-page .topbar-right-actions .dashboard-profile-row {
    flex: 0 0 auto;
    margin: 0;
}

.dashboard-profile-row,
.dashboard-action-groups {
    display: flex;
    align-items: center;
    gap: 12px;
}

.dashboard-profile-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 15px;
    z-index: 2;
}

.dashboard-profile-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    padding: 0;
    border-radius: 999px;
    text-decoration: none;
    color: var(--ink);
    background: rgba(255, 255, 255, 0.38);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-soft);
}

body[data-theme="dark"] .dashboard-profile-link {
    background: rgba(15, 29, 46, 0.74);
}

.dashboard-profile-avatar {
    width: 48px;
    height: 48px;
    border-radius: 999px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: linear-gradient(135deg, rgba(69, 167, 230, 0.14), rgba(255, 210, 58, 0.18));
    display: grid;
    place-items: center;
    flex-shrink: 0;
}

.dashboard-profile-avatar img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
}

.dashboard-profile-avatar span {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--primary);
}

/* ── Profile Dropdown ── */
.profile-dropdown {
    position: relative;
}
.profile-dropdown-trigger {
    display: flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
}
.profile-chevron {
    font-size: 0.85rem;
    color: var(--muted);
    transition: transform 0.3s ease;
}
.profile-dropdown.is-open .profile-chevron {
    transform: rotate(180deg);
}
.profile-dropdown-menu {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    min-width: 220px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 8px;
    box-shadow: 0 12px 40px rgba(0,0,0,0.15);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px) scale(0.97);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 9999;
}
.profile-dropdown.is-open .profile-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
}
.profile-dropdown-header {
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 2px;
}
.profile-dropdown-header strong {
    font-size: 0.92rem;
    color: var(--ink);
}
.profile-dropdown-header span {
    font-size: 0.75rem;
    color: var(--muted);
    font-weight: 500;
}
.profile-dropdown-divider {
    height: 1px;
    background: var(--line);
    margin: 4px 0;
}
.profile-dropdown-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 10px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    transition: background 0.2s ease;
    cursor: pointer;
    width: 100%;
    border: none;
    background: none;
    text-align: left;
}
.profile-dropdown-item ion-icon {
    font-size: 1.1rem;
    color: var(--muted);
}
.profile-dropdown-item:hover {
    background: rgba(15, 118, 110, 0.06);
}
.profile-dropdown-item:hover ion-icon {
    color: var(--primary);
}
.profile-dropdown-logout {
    color: var(--danger);
}
.profile-dropdown-logout ion-icon {
    color: var(--danger) !important;
}
.profile-dropdown-logout:hover {
    background: rgba(239, 68, 68, 0.08) !important;
}

.dashboard-action-groups {
    width: 100%;
    display: grid;
    gap: 10px;
    justify-items: stretch;
}

.dashboard-action-row {
    display: grid;
    grid-template-columns: 1fr;
    justify-content: flex-start;
    width: 100%;
    gap: 10px;
}

.dashboard-action-row > a,
.dashboard-action-row > form {
    width: 100%;
    flex: none;
}

.dashboard-action-row .ghost-button,
.dashboard-action-row .danger-button {
    width: 100%;
    min-height: 44px;
    justify-content: flex-start;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 14px;
    background: rgba(15, 118, 110, 0.08);
    box-shadow: none;
    text-align: left;
}

.dashboard-action-row .ghost-button:hover,
.dashboard-action-row .danger-button:hover {
    transform: translateX(3px);
}

.dashboard-action-row .danger-button {
    justify-content: flex-start;
    background: linear-gradient(135deg, #f25757 0%, #ff6b6b 100%);
    color: #fff;
    box-shadow: 0 12px 24px rgba(239, 68, 68, 0.18);
}

.dashboard-action-row .inline-form button {
    margin: 0;
}

.dashboard-logout-form {
    margin-left: 0;
}

.dashboard-quick-search {
    width: min(360px, 100%);
    position: relative;
}

.dashboard-search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    transform: translateY(-50%);
    font-family: "Arista Pro Icons", "Segoe UI Symbol", "Segoe UI Emoji", sans-serif;
    font-size: 1rem;
    line-height: 1;
    color: rgba(135, 149, 168, 0.84);
    pointer-events: none;
    z-index: 1;
}

body[data-theme="dark"] .dashboard-search-icon {
    color: rgba(161, 175, 197, 0.8);
}

.dashboard-quick-search input {
    width: 100%;
    min-height: 46px;
    border-radius: 14px;
    box-shadow: var(--shadow-soft);
    padding-left: 42px;
}

.quick-search-results {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    right: 0;
    z-index: 30;
    display: grid;
    gap: 8px;
    padding: 10px;
    background: rgba(255, 251, 245, 0.98);
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: var(--shadow);
}

body[data-theme="dark"] .quick-search-results {
    background: rgba(19, 35, 56, 0.98);
}

.quick-search-result-item {
    display: grid;
    gap: 3px;
    width: 100%;
    padding: 12px 14px;
    border-radius: 14px;
    background: rgba(13, 110, 110, 0.06);
    background-image: none !important;
    color: var(--ink);
    border: 1px solid rgba(13, 110, 110, 0.08);
    text-align: left;
    text-decoration: none;
    box-shadow: none;
    appearance: none;
    -webkit-appearance: none;
    transform: none !important;
}

.quick-search-result-item strong {
    font-size: 0.98rem;
    color: var(--ink);
}

.quick-search-result-item span,
.quick-search-result-item small {
    color: var(--muted);
}

.quick-search-result-type {
    display: inline-flex;
    justify-self: start;
    padding: 4px 8px;
    border-radius: 999px;
    background: rgba(168, 122, 0, 0.16);
    color: rgba(115, 79, 0, 0.92) !important;
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.quick-search-highlight {
    padding: 0 3px;
    border-radius: 5px;
    background: rgba(255, 221, 87, 0.82);
    color: #2b2210;
}

body[data-theme="dark"] .quick-search-result-item {
    background: rgba(13, 110, 110, 0.08);
    background-image: none !important;
    color: var(--ink);
    border-color: rgba(103, 209, 202, 0.14);
    box-shadow: none;
}

.quick-search-result-item:hover,
.quick-search-result-item:focus,
.quick-search-result-item:active,
body[data-theme="dark"] .quick-search-result-item:hover,
body[data-theme="dark"] .quick-search-result-item:focus,
body[data-theme="dark"] .quick-search-result-item:active {
    background: rgba(13, 110, 110, 0.06) !important;
    background-image: none !important;
    transform: none !important;
}

body[data-theme="dark"] .quick-search-result-item:hover,
body[data-theme="dark"] .quick-search-result-item:focus,
body[data-theme="dark"] .quick-search-result-item:active {
    background: rgba(13, 110, 110, 0.08) !important;
}

body[data-theme="dark"] .quick-search-result-item strong {
    color: var(--ink);
}

body[data-theme="dark"] .quick-search-result-item span,
body[data-theme="dark"] .quick-search-result-item small {
    color: var(--muted);
}

body[data-theme="dark"] .quick-search-result-type {
    background: rgba(168, 122, 0, 0.16);
    color: rgba(115, 79, 0, 0.92) !important;
}

body[data-theme="dark"] .quick-search-highlight {
    background: rgba(255, 214, 69, 0.78);
    color: #21190a;
}

.quick-search-empty {
    padding: 14px;
    border-radius: 14px;
    color: var(--muted);
    background: rgba(13, 110, 110, 0.06);
}

.dashboard-search-match {
    border-color: inherit !important;
    background-color: inherit !important;
    outline: none;
    box-shadow: none;
}

.dashboard-search-active {
    border-color: inherit !important;
    background-color: inherit !important;
    outline: none;
    box-shadow: none;
}

body[data-theme="dark"] .dashboard-search-match {
    border-color: inherit !important;
    background-color: inherit !important;
    outline: none;
    box-shadow: none;
}

body[data-theme="dark"] .dashboard-search-active {
    border-color: inherit !important;
    background-color: inherit !important;
    outline: none;
    box-shadow: none;
}

.topbar-actions,
.inline-actions,
.card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
}

.icon-button {
    gap: 8px;
}

.back-nav-button {
    padding: 12px 20px;
    border-radius: 18px;
    background: rgba(13, 110, 110, 0.12);
    box-shadow: inset 0 0 0 1px rgba(103, 209, 202, 0.06);
}

.back-nav-button .icon-glyph {
    background: rgba(255, 255, 255, 0.2);
    color: inherit;
}

body[data-theme="dark"] .back-nav-button {
    background: rgba(103, 209, 202, 0.14);
    box-shadow: inset 0 0 0 1px rgba(103, 209, 202, 0.08);
}

.icon-glyph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    font-family: "Arista Pro Icons", "Segoe UI Symbol", "Segoe UI Emoji", sans-serif;
    font-size: 0.78rem;
    font-weight: 800;
    line-height: 1;
}

.topbar-actions {
    justify-content: flex-end;
}

.profile-panel {
    padding: 26px;
}

.profile-form {
    gap: 0;
}

.profile-layout {
    display: grid;
    grid-template-columns: minmax(260px, 320px) minmax(0, 1fr);
    gap: 22px;
    align-items: start;
}

.my-records-layout {
    grid-template-columns: minmax(0, 1fr) minmax(260px, 320px);
}

.student-request-panel {
    margin-bottom: 18px;
}

.request-history-list,
.notifications-list {
    display: grid;
    gap: 14px;
}

.request-history-card,
.notification-card {
    padding: 16px 18px;
    border-radius: 20px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.24);
    box-shadow: var(--shadow-soft);
}

.request-history-top,
.notification-top,
.review-queue-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
}

.notification-card-unread {
    border-color: rgba(13, 110, 110, 0.28);
    background: rgba(82, 210, 200, 0.1);
}

.notification-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 10px;
}

.review-queue-grid {
    display: grid;
    gap: 18px;
}

.review-queue-card textarea {
    min-height: 96px;
}

.certificate-preview-shell {
    display: flex;
    justify-content: center;
}

.certificate-preview-card {
    width: min(100%, 900px);
    padding: 28px;
    border-radius: 28px;
    border: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0.14));
    box-shadow: var(--shadow);
}

.certificate-preview-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 18px;
}

.certificate-preview-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 18px;
}

.certificate-preview-note {
    margin-top: 14px;
}

.certificate-preview-actions {
    margin-top: 18px;
}

.certificate-preview-hash {
    margin-top: 12px;
}

.profile-sidebar {
    display: grid;
    gap: 16px;
}

.profile-avatar-card,
.profile-meta-card {
    padding: 20px;
    border-radius: 22px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.42);
    box-shadow: var(--shadow-soft);
}

body[data-theme="dark"] .profile-avatar-card,
body[data-theme="dark"] .profile-meta-card {
    background: rgba(15, 29, 46, 0.72);
}

.profile-avatar-card {
    text-align: center;
}

.profile-avatar-card h3 {
    margin-bottom: 4px;
}

.profile-remove-photo-button {
    width: 100%;
    margin-top: 8px;
}

.profile-avatar-shell {
    width: 130px;
    height: 130px;
    margin: 0 auto 16px;
    border-radius: 28px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: linear-gradient(135deg, rgba(69, 167, 230, 0.12), rgba(255, 210, 58, 0.16));
    box-shadow: var(--shadow-soft);
}

.profile-avatar-image,
.profile-avatar-fallback {
    width: 100%;
    height: 100%;
}

.profile-avatar-image {
    display: block;
    object-fit: cover;
}

.profile-avatar-fallback {
    display: grid;
    place-items: center;
    font-size: 3rem;
    font-weight: 800;
    color: var(--primary);
}

.profile-meta-card {
    display: grid;
    gap: 14px;
}

.compact-summary-item strong.status-badge {
    justify-self: start;
}

.compact-summary-item {
    display: grid;
    gap: 4px;
}

.compact-summary-label {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
}

.profile-fields {
    display: grid;
    gap: 12px;
}

.profile-fields .compact-summary-text {
    margin-top: -4px;
    margin-bottom: 4px;
}

.profile-directory-card {
    display: grid;
    gap: 10px;
}

.profile-directory-head {
    display: flex;
    align-items: center;
    gap: 14px;
}

.profile-directory-head h3 {
    margin-bottom: 4px;
}

.profile-directory-avatar-link,
.profile-directory-name-link {
    text-decoration: none;
    color: inherit;
}

.profile-directory-avatar-link {
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
    width: auto;
    min-width: 0;
    min-height: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    box-shadow: none;
    border-radius: 999px;
    overflow: hidden;
}

.profile-directory-avatar-static {
    cursor: default;
}

.profile-directory-name-link:hover {
    color: var(--primary);
}

.profile-directory-avatar-shell {
    width: 64px;
    height: 64px;
    border-radius: 999px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: linear-gradient(135deg, rgba(69, 167, 230, 0.12), rgba(255, 210, 58, 0.16));
    flex-shrink: 0;
}

.profile-directory-avatar-image,
.profile-directory-avatar-fallback {
    width: 100%;
    height: 100%;
}

.profile-directory-avatar-image {
    display: block;
    object-fit: cover;
