/* =========================================================================
   INTEGRITY SCAN BUTTON – Premium CTA
   ========================================================================= */
.integrity-scan-btn {
    display: inline-flex !important;
    align-items: center;
    gap: 10px;
    padding: 14px 32px !important;
    font-family: "Outfit", sans-serif;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #fff !important;
    text-decoration: none !important;
    border: none !important;
    border-radius: 16px !important;
    background: linear-gradient(135deg, #6366f1 0%, #3b82f6 50%, #8b5cf6 100%) !important;
    background-size: 100% 100% !important;
    animation: none !important;
    box-shadow: 0 6px 24px rgba(99, 102, 241, 0.35), 0 0 0 0 rgba(139, 92, 246, 0) !important;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
}

.integrity-scan-btn ion-icon {
    font-size: 1.3rem;
    flex-shrink: 0;
}

@keyframes scanGradientShift {
    0%   { background-position: 0% 50%; }
    50%  { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}

@keyframes rippleOut {
    to {
        transform: scale(4);
        opacity: 0;
    }
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

.integrity-scan-btn:hover {
    transform: translateY(-3px) scale(1.03) !important;
    box-shadow: 0 10px 36px rgba(99, 102, 241, 0.45), 0 0 20px rgba(139, 92, 246, 0.2) !important;
}

.integrity-scan-btn:active {
    transform: translateY(0) scale(0.97) !important;
    box-shadow: 0 4px 16px rgba(99, 102, 241, 0.3) !important;
}

/* Ripple effect */
.integrity-scan-btn::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: width 0.6s ease, height 0.6s ease, opacity 0.6s ease;
}

.integrity-scan-btn:active::after {
    width: 300px;
    height: 300px;
    opacity: 0;
    transition: 0s;
}

/* Focus ring for accessibility */
.integrity-scan-btn:focus-visible {
    outline: none;
    box-shadow: 0 6px 24px rgba(15, 118, 110, 0.35), 0 0 0 4px rgba(45, 212, 191, 0.4) !important;
}

/* Dark mode refinement */
body[data-theme="dark"] .integrity-scan-btn {
    box-shadow: 0 6px 24px rgba(99, 102, 241, 0.25), 0 0 0 0 rgba(139, 92, 246, 0) !important;
}

body[data-theme="dark"] .integrity-scan-btn:hover {
    box-shadow: 0 10px 36px rgba(99, 102, 241, 0.35), 0 0 24px rgba(139, 92, 246, 0.15) !important;
}

