<script>
document.addEventListener("DOMContentLoaded", function() {
    const dashboardShell = document.querySelector(".dashboard-shell");
    const sidebarToggleButtons = document.querySelectorAll("[data-dashboard-sidebar-toggle]");

    if (dashboardShell && sidebarToggleButtons.length) {
        const savedSidebarState = localStorage.getItem("hashvera-dashboard-sidebar");
        const startsOnMobile = window.matchMedia("(max-width: 960px)").matches;

        function setSidebarHidden(isHidden, options = {}) {
            dashboardShell.classList.toggle("dashboard-sidebar-hidden", isHidden);
            dashboardShell.classList.toggle("dashboard-sidebar-open", !isHidden);
            sidebarToggleButtons.forEach((button) => {
                const icon = button.querySelector("ion-icon");
                const label = button.querySelector("span");
                button.setAttribute("aria-expanded", String(!isHidden));
                button.setAttribute("aria-label", isHidden ? "Open dashboard menu" : "Hide dashboard menu");
                button.title = isHidden ? "Open menu" : "Hide menu";
                if (icon) {
                    icon.setAttribute("name", isHidden ? "chevron-forward-outline" : "chevron-back-outline");
                }
                if (label) {
                    label.textContent = isHidden ? "Open Menu" : "Hide Menu";
                }
            });
            if (!options.skipPersist) {
                localStorage.setItem("hashvera-dashboard-sidebar", isHidden ? "hidden" : "open");
            }
        }

        setSidebarHidden(startsOnMobile ? true : (savedSidebarState ? savedSidebarState === "hidden" : false), { skipPersist: startsOnMobile });
        dashboardShell.dataset.dashboardSidebarReady = "true";

        sidebarToggleButtons.forEach((button) => {
            button.addEventListener("click", () => {
                setSidebarHidden(dashboardShell.classList.contains("dashboard-sidebar-open"), { skipPersist: startsOnMobile });
            });
        });
    }

    // 1. Visual Integrity Scanner
    const scanBtn = document.getElementById("run-integrity-scan");
    if (scanBtn && !document.getElementById("integrity-overlay")) {
        scanBtn.addEventListener("click", async function(e) {
            e.preventDefault();
            // Ripple effect
            const rect = scanBtn.getBoundingClientRect();
            const ripple = document.createElement("span");
            const size = Math.max(rect.width, rect.height);
            ripple.style.cssText = `position:absolute;border-radius:50%;background:rgba(255,255,255,0.4);width:${size}px;height:${size}px;left:${e.clientX - rect.left - size/2}px;top:${e.clientY - rect.top - size/2}px;transform:scale(0);animation:rippleOut 0.6s ease-out forwards;pointer-events:none;`;
            scanBtn.appendChild(ripple);
            setTimeout(() => ripple.remove(), 700);

            const blocks = document.querySelectorAll('.ledger-chain .block-card');
            scanBtn.disabled = true;
            scanBtn.innerHTML = '<span class="spinner" style="display:inline-block; width:16px; height:16px; border:2.5px solid rgba(255,255,255,0.3); border-top:2.5px solid white; border-radius:50%; animation:spin 0.8s linear infinite;"></span> Scanning Chain...';
            
            for (let i = blocks.length - 1; i >= 0; i--) {
                const block = blocks[i];
                block.scrollIntoView({ behavior: "smooth", block: "center" });
                
                block.style.transition = "all 0.3s";
                block.style.boxShadow = "0 0 20px rgba(16, 185, 129, 0.4)";
                block.style.borderColor = "var(--success)";
                
                await new Promise(r => setTimeout(r, 600));
                
                block.style.boxShadow = "none";
                block.style.borderColor = "var(--line)";
            }
            
            scanBtn.innerHTML = '<ion-icon name="checkmark-circle-outline"></ion-icon> Chain Verified';
            scanBtn.style.background = "var(--success)";
            scanBtn.style.animation = "none";
            setTimeout(() => {
                scanBtn.disabled = false;
                scanBtn.innerHTML = '<ion-icon name="shield-checkmark-outline"></ion-icon><span>Run Integrity Scan</span>';
                scanBtn.style.background = "";
                scanBtn.style.animation = "";
            }, 3000);
        });
    }

    // 2. Cryptographic Block Inspector
    const inspectBtns = document.querySelectorAll('.inspect-block-btn');
    const inspectorModal = document.getElementById('inspector-modal');
    const inspectorJson = document.getElementById('inspector-json');
    const inspectorSig = document.getElementById('inspector-sig');
    const closeBtn = document.getElementById('close-inspector');

    inspectBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const payload = JSON.parse(btn.getAttribute('data-payload'));
            inspectorJson.textContent = JSON.stringify(payload, null, 2);
            inspectorSig.textContent = payload.block_signature || payload.block_hash || "GENESIS-ROOT-HASH";
            inspectorModal.showModal();
        });
    });

    if (closeBtn) {
        closeBtn.addEventListener('click', () => {
            inspectorModal.close();
        });
    }

    // 3. Share Proof Button
    const shareBtns = document.querySelectorAll('.share-proof-btn');
    shareBtns.forEach(btn => {
        btn.addEventListener('click', async () => {
            const shareUrl = btn.getAttribute('data-share-url');
            if (navigator.share) {
                try {
                    await navigator.share({
                        title: 'Verified Academic Record',
                        text: 'View this verified academic record on HashVera:',
                        url: shareUrl
                    });
                } catch (err) {
                    if (err.name !== 'AbortError') {
                        console.error('Error sharing:', err);
                    }
                }
            } else {
                try {
                    await navigator.clipboard.writeText(shareUrl);
                    if (window.showToast) {
                        window.showToast('Verification link copied to clipboard!', 'success');
                    } else {
                        alert('Link copied to clipboard!');
                    }
                } catch (err) {
                    console.error('Failed to copy link:', err);
                    alert('Failed to copy link.');
                }
            }
        });
    });
});
</script>
