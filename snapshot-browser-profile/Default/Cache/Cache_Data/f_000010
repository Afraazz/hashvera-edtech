document.addEventListener('DOMContentLoaded', function() {
    const runBtn = document.getElementById('run-integrity-scan');
    const overlay = document.getElementById('integrity-overlay');
    const progressFill = document.getElementById('integrity-progress-fill');
    const blockCounter = document.getElementById('integrity-block-counter');
    const statusText = document.querySelector('.integrity-status-text');
    const ledgerItems = document.querySelectorAll('.ledger-feed-item');
    
    if (!runBtn) return;

    runBtn.addEventListener('click', async function(event) {
        event.preventDefault();
        // Show overlay
        overlay.classList.add('active');
        runBtn.disabled = true;
        
        const totalItems = ledgerItems.length;
        
        // Simulate scanning blocks for visual effect
        if (totalItems > 0) {
            for (let i = 0; i < totalItems; i++) {
                const progress = ((i + 1) / totalItems) * 100;
                progressFill.style.width = progress + '%';
                blockCounter.textContent = `Scanning entry ${i + 1}/${totalItems}`;
                
                // Highlight the card being scanned
                ledgerItems[i].style.background = 'rgba(15, 118, 110, 0.1)';
                ledgerItems[i].style.transform = 'scale(1.02)';
                ledgerItems[i].style.zIndex = '10';
                ledgerItems[i].style.position = 'relative';
                await new Promise(r => setTimeout(r, 150));
                ledgerItems[i].style.background = '';
                ledgerItems[i].style.transform = '';
            }
        } else {
            progressFill.style.width = '100%';
            await new Promise(r => setTimeout(r, 500));
        }

        // Perform actual check
        try {
            const response = await fetch("/ledger/verify/ajax");
            const data = await response.json();
            
            statusText.textContent = data.valid ? "Integrity Verified!" : "Integrity Issue Detected!";
            statusText.style.color = data.valid ? "var(--success)" : "var(--danger)";
            
            setTimeout(() => {
                window.location.reload();
            }, 1000);
        } catch (error) {
            console.error("Verification failed:", error);
            overlay.classList.remove('active');
            runBtn.disabled = false;
        }
    });
});
</script>

