<script>
    window.dashboardChartData = JSON.parse(document.getElementById('dashboard-chart-data-json').textContent);
    document.addEventListener("DOMContentLoaded", function () {
        const input = document.getElementById("dashboard-quick-search");
        const results = document.getElementById("quick-search-results");
        const targets = Array.from(document.querySelectorAll(".dashboard-search-target"));
        let activeHighlight = null;

        if (!input || !results) {
            return;
        }

        function escapeHtml(value) {
            return String(value || "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#39;");
        }

        function escapeRegExp(value) {
            return String(value || "").replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
        }

        function highlightSearchText(value, query) {
            const safeValue = escapeHtml(value);
            if (!query) {
                return safeValue;
            }

            const matcher = new RegExp("(" + escapeRegExp(query) + ")", "ig");
            return safeValue.replace(matcher, '<mark class="quick-search-highlight">$1</mark>');
        }

        function clearHighlights() {
            targets.forEach(function (item) {
                item.classList.remove("dashboard-search-match");
            });
            if (activeHighlight) {
                activeHighlight.classList.remove("dashboard-search-active");
                activeHighlight = null;
            }
        }

        function hideResults() {
            results.hidden = true;
            results.innerHTML = "";
            clearHighlights();
        }

        function renderResults(matches, query) {
            if (!query) {
                hideResults();
                return;
            }

            if (!matches.length) {
                results.innerHTML = '<div class="quick-search-empty">No matching results.</div>';
                results.hidden = false;
                return;
            }

            results.innerHTML = matches.map(function (item) {
                return `
                    <button type="button" class="quick-search-result-item" data-target-id="${item.id}">
                        <span class="quick-search-result-type">${highlightSearchText(item.type, query)}</span>
                        <strong>${highlightSearchText(item.title, query)}</strong>
                        <span>${highlightSearchText(item.subtitle, query)}</span>
                        <small>${highlightSearchText(item.hint, query)}</small>
                    </button>
                `;
            }).join("");
            results.hidden = false;
        }

        function buildMatches(query) {
            return targets.filter(function (item) {
                const haystack = (item.getAttribute("data-dashboard-search") || item.textContent || "").toLowerCase();
                const matched = query && haystack.includes(query);
                item.classList.toggle("dashboard-search-match", Boolean(matched));
                return matched;
            }).slice(0, 8).map(function (item) {
                return {
                    id: item.id,
                    type: item.getAttribute("data-dashboard-type") || "Result",
                    title: item.getAttribute("data-dashboard-label") || item.querySelector("h2, h3, strong, span")?.textContent?.trim() || "Result",
                    subtitle: item.getAttribute("data-dashboard-search") || "",
                    hint: "Click to jump to this section.",
                };
            });
        }

        input.addEventListener("input", function () {
            const query = input.value.trim().toLowerCase();
            const matches = buildMatches(query);
            renderResults(matches, query);
        });

        results.addEventListener("click", function (event) {
            const trigger = event.target.closest("[data-target-id]");
            if (!trigger) {
                return;
            }
            const target = document.getElementById(trigger.getAttribute("data-target-id"));
            if (!target) {
                return;
            }

            if (activeHighlight) {
                activeHighlight.classList.remove("dashboard-search-active");
            }

            activeHighlight = target;
            target.classList.add("dashboard-search-active");
            target.scrollIntoView({ behavior: "smooth", block: "center" });
            results.hidden = true;
        });

        document.addEventListener("click", function (event) {
            if (!event.target.closest(".dashboard-quick-search")) {
                results.hidden = true;
            }
        });
        input.addEventListener("focus", function () {
            const query = input.value.trim().toLowerCase();
            if (!query) {
                return;
            }
            const matches = buildMatches(query);
            renderResults(matches, query);
        });

        document.addEventListener("ajax-action-success", function (event) {
            const form = event.detail.form;
            const targetBlock = form.closest(".block-card, .audit-card, .user-admin-card");
            if (targetBlock) {
                targetBlock.style.transition = "all 0.4s cubic-bezier(0.4, 0, 0.2, 1)";
                targetBlock.style.opacity = "0";
                targetBlock.style.transform = "scale(0.95) translateY(10px)";
                targetBlock.style.maxHeight = targetBlock.offsetHeight + "px";
                
                setTimeout(() => {
                    targetBlock.style.maxHeight = "0";
                    targetBlock.style.margin = "0";
                    targetBlock.style.padding = "0";
                    setTimeout(() => {
                        targetBlock.remove();
                    }, 400);
                }, 100);
            }
        });
    });
</script>
