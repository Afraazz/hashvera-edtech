        <div class="integrity-status-text">Verifying Ledger Integrity...</div>
        <div class="integrity-progress-bar">
            <div id="integrity-progress-fill" class="integrity-progress-fill"></div>
        </div>
        <div id="integrity-block-counter" class="integrity-block-counter">Scanning block 0/28</div>
    </div>
