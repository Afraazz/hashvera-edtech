<script>
document.addEventListener('DOMContentLoaded', function() {
    const runBtn = document.getElementById('run-integrity-btn');
    const overlay = document.getElementById('integrity-overlay');
    const progressFill = document.getElementById('integrity-progress-fill');
    const blockCounter = document.getElementById('integrity-block-counter');
    const statusText = document.querySelector('.integrity-status-text');
    const blockCards = document.querySelectorAll('.chain-block-card');
    
    if (!runBtn) return;

    runBtn.addEventListener('click', async function() {
        // Show overlay
        overlay.classList.add('active');
        runBtn.disabled = true;
        
        const totalBlocks = 28;
        if (totalBlocks === 0) {
            setTimeout(() => {
                overlay.classList.remove('active');
                runBtn.disabled = false;
            }, 1000);
            return;
        }

        // Simulate scanning blocks for visual effect
        for (let i = 0; i < totalBlocks; i++) {
            const progress = ((i + 1) / totalBlocks) * 100;
            progressFill.style.width = progress + '%';
            blockCounter.textContent = `Scanning block ${i + 1}/${totalBlocks}`;
            
            // Highlight the card being scanned
            if (blockCards[i]) {
                blockCards[i].scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' });
                blockCards[i].classList.add('scanning-active');
                await new Promise(r => setTimeout(r, 150)); // Slow down for effect
                blockCards[i].classList.remove('scanning-active');
                blockCards[i].classList.add('scanning-verified');
            }
        }

        // Perform actual check
        try {
            const response = await fetch("/ledger/verify/ajax");
            const data = await response.json();
            
            statusText.textContent = data.valid ? "Integrity Verified!" : "Integrity Issue Detected!";
            statusText.style.color = data.valid ? "var(--success)" : "var(--danger)";
            
            if (data.valid) {
                // Show success state briefly then reload to update tags
                setTimeout(() => {
                    window.location.reload();
                }, 1000);
            } else {
                // Keep overlay or show errors?
                // For now, let's reload to show the error banner
                setTimeout(() => {
                    window.location.reload();
                }, 1500);
            }
        } catch (error) {
            console.error("Verification failed:", error);
            overlay.classList.remove('active');
            runBtn.disabled = false;
        }
    });
});
</script>

